@prefix : <https://example.org/f1-ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sulo: <https://w3id.org/sulo/> .

<https://w3id.org/sulo/schema/resource/ontology-schema/f8f82c9d-b20c-480a-be46-89a22f909414>
    a owl:Ontology ;
    dct:title "Formula 1 World Championship Hybrid Model" ;
    dct:description "A Formula 1 World Championship hybrid schema that preserves the ad-hoc domain vocabulary and adds selected SULO semantic enrichments: temporal precedence between seasons and races, spatial context for race/circuit, team membership, and SULO grounding for Position rank." ;
    owl:imports <https://w3id.org/sulo/> .

# ── Classes ──────────────────────────────────────────────────────────────

:Circuit
    a owl:Class ;
    rdfs:label "circuit" ;
    rdfs:comment "A physical racing circuit at which a Formula 1 race takes place." ;
    rdfs:subClassOf sulo:SpatialObject .

:Driver
    a owl:Class ;
    rdfs:label "driver" ;
    rdfs:comment "A person competing as a Formula 1 driver." ;
    rdfs:subClassOf sulo:SpatialObject .

:Position
    a owl:Class ;
    rdfs:label "position" ;
    rdfs:comment "An ordinal quality representing a driver's classified position within a race or session." ;
    rdfs:subClassOf sulo:Quality .

:Race
    a owl:Class ;
    rdfs:label "race" ;
    rdfs:comment "A Formula 1 Grand Prix held as part of a championship season." ;
    rdfs:subClassOf sulo:Process .

:RaceEntry
    a owl:Class ;
    rdfs:label "race entry" ;
    rdfs:comment "The participation and resulting performance of one driver, representing one team, in one race." ;
    rdfs:subClassOf sulo:Process .

:Season
    a owl:Class ;
    rdfs:label "season" ;
    rdfs:comment "A Formula 1 championship season consisting of a sequence of races." ;
    rdfs:subClassOf sulo:Process .

:SessionResult
    a owl:Class ;
    rdfs:label "session result" ;
    rdfs:comment "A driver's performance in a non-race session associated with a race weekend, such as practice, qualifying, or sprint." ;
    rdfs:subClassOf sulo:InformationObject .

:Team
    a owl:Class ;
    rdfs:label "team" ;
    rdfs:comment "A Formula 1 team represented as an organizational collection for which drivers compete." ;
    rdfs:subClassOf sulo:Collection .

# ── Properties ───────────────────────────────────────────────────────────

:hasBestLapTime
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has best lap time" ;
    rdfs:comment "Specifies the driver's best recorded lap time during the session, measured in seconds." ;
    rdfs:domain <https://example.org/f1-ontology/SessionResult_hasBestLapTime_domain> ;
    rdfs:range xsd:decimal .

:hasCircuitName
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has circuit name" ;
    rdfs:comment "Specifies the name of the racing circuit." ;
    rdfs:domain <https://example.org/f1-ontology/Circuit_hasCircuitName_domain> ;
    rdfs:range xsd:string .

:hasCountry
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has country" ;
    rdfs:comment "Specifies the country in which the circuit is located." ;
    rdfs:domain <https://example.org/f1-ontology/Circuit_hasCountry_domain> ;
    rdfs:range xsd:string .

:hasDateOfBirth
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has date of birth" ;
    rdfs:comment "Specifies the driver's date of birth." ;
    rdfs:domain <https://example.org/f1-ontology/Driver_hasDateOfBirth_domain> ;
    rdfs:range xsd:date .

:hasDriver
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has driver" ;
    rdfs:comment "Associates a race entry with the driver participating in the race." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasDriver_domain> ;
    rdfs:range <https://example.org/f1-ontology/RaceEntry_hasDriver_range> .

:hasDriverName
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has driver name" ;
    rdfs:comment "Specifies the full name of the driver." ;
    rdfs:domain <https://example.org/f1-ontology/Driver_hasDriverName_domain> ;
    rdfs:range xsd:string .

:hasFinishPosition
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has finish position" ;
    rdfs:comment "Specifies the driver's final classified position in the race, when applicable." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasFinishPosition_domain> ;
    rdfs:range <https://example.org/f1-ontology/RaceEntry_hasFinishPosition_range> .

:hasLapsCompleted
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has laps completed" ;
    rdfs:comment "Specifies the number of race laps completed by the driver." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasLapsCompleted_domain> ;
    rdfs:range xsd:integer .

:hasLocation
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has location" ;
    rdfs:comment "Specifies the city or locality in which the circuit is located." ;
    rdfs:domain <https://example.org/f1-ontology/Circuit_hasLocation_domain> ;
    rdfs:range xsd:string .

:hasNationality
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has nationality" ;
    rdfs:comment "Specifies the driver's nationality." ;
    rdfs:domain <https://example.org/f1-ontology/Driver_hasNationality_domain> ;
    rdfs:range xsd:string .

:hasPosition
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has position" ;
    rdfs:comment "Specifies the driver's classified or ranked position in the session." ;
    rdfs:domain <https://example.org/f1-ontology/SessionResult_hasPosition_domain> ;
    rdfs:range <https://example.org/f1-ontology/SessionResult_hasPosition_range> .

:hasRaceDate
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has race date" ;
    rdfs:comment "Specifies the date on which the race takes place." ;
    rdfs:domain <https://example.org/f1-ontology/Race_hasRaceDate_domain> ;
    rdfs:range xsd:date .

:hasRaceEntry
    a owl:ObjectProperty ;
    rdfs:label "has race entry" ;
    rdfs:comment "Associates a race with a driver's participation and result in that race." ;
    rdfs:domain <https://example.org/f1-ontology/Race_hasRaceEntry_domain> ;
    rdfs:range <https://example.org/f1-ontology/Race_hasRaceEntry_range> .

:hasRaceName
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has race name" ;
    rdfs:comment "Specifies the official name of the race." ;
    rdfs:domain <https://example.org/f1-ontology/Race_hasRaceName_domain> ;
    rdfs:range xsd:string .

:hasRacePoints
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has race points" ;
    rdfs:comment "Specifies whether the driver scored championship points in the race." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasRacePoints_domain> ;
    rdfs:range xsd:boolean .

:hasRank
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has rank" ;
    rdfs:comment "Specifies the ordinal rank of a classified position (0 or greater, where 1 = first)." ;
    rdfs:domain <https://example.org/f1-ontology/Position_hasRank_domain> ;
    rdfs:range xsd:nonNegativeInteger .

:hasRound
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has round" ;
    rdfs:comment "Specifies the race's round number within the championship season." ;
    rdfs:domain <https://example.org/f1-ontology/Race_hasRound_domain> ;
    rdfs:range xsd:integer .

:hasSessionLapsCompleted
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has session laps completed" ;
    rdfs:comment "Specifies the number of laps completed during the session when available." ;
    rdfs:domain <https://example.org/f1-ontology/SessionResult_hasSessionLapsCompleted_domain> ;
    rdfs:range xsd:integer .

:hasSessionPoints
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has session points" ;
    rdfs:comment "Specifies whether the driver scored championship points in the session, when the session awards points." ;
    rdfs:domain <https://example.org/f1-ontology/SessionResult_hasSessionPoints_domain> ;
    rdfs:range xsd:boolean .

:hasSessionResult
    a owl:ObjectProperty ;
    rdfs:label "has session result" ;
    rdfs:comment "Associates a race entry with a practice, qualifying, or sprint performance from the same race weekend." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasSessionResult_domain> ;
    rdfs:range <https://example.org/f1-ontology/RaceEntry_hasSessionResult_range> .

:hasSessionType
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has session type" ;
    rdfs:comment "Specifies whether the performance occurred during practice, qualifying, or sprint." ;
    rdfs:domain <https://example.org/f1-ontology/SessionResult_hasSessionType_domain> ;
    rdfs:range xsd:string .

:hasStartPosition
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has start position" ;
    rdfs:comment "Specifies the driver's starting grid position for the race." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasStartPosition_domain> ;
    rdfs:range <https://example.org/f1-ontology/RaceEntry_hasStartPosition_range> .

:hasStatus
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has status" ;
    rdfs:comment "Describes how the driver's race ended, such as finished, retired, or disqualified." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasStatus_domain> ;
    rdfs:range xsd:string .

:hasTeam
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has team" ;
    rdfs:comment "Associates a race entry with the team represented by the driver." ;
    rdfs:domain <https://example.org/f1-ontology/RaceEntry_hasTeam_domain> ;
    rdfs:range <https://example.org/f1-ontology/RaceEntry_hasTeam_range> .

:hasTeamMember
    a owl:ObjectProperty ;
    rdfs:label "has team member" ;
    rdfs:comment "Associates a Formula 1 team with a driver who has represented that team in at least one race entry." ;
    rdfs:domain <https://example.org/f1-ontology/Team_hasTeamMember_domain> ;
    rdfs:range <https://example.org/f1-ontology/Team_hasTeamMember_range> .

:hasTeamName
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has team name" ;
    rdfs:comment "Specifies the name of the Formula 1 team." ;
    rdfs:domain <https://example.org/f1-ontology/Team_hasTeamName_domain> ;
    rdfs:range xsd:string .

:hasTeamNationality
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has team nationality" ;
    rdfs:comment "Specifies the nationality associated with the Formula 1 team." ;
    rdfs:domain <https://example.org/f1-ontology/Team_hasTeamNationality_domain> ;
    rdfs:range xsd:string .

:hasYear
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "has year" ;
    rdfs:comment "Specifies the championship year represented by the season." ;
    rdfs:domain <https://example.org/f1-ontology/Season_hasYear_domain> ;
    rdfs:range xsd:integer .

:isInCircuit
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "is in circuit" ;
    rdfs:comment "Adds explicit SULO spatial context by relating a race process to the circuit in which it occurs." ;
    rdfs:domain <https://example.org/f1-ontology/Race_isInCircuit_domain> ;
    rdfs:range <https://example.org/f1-ontology/Race_isInCircuit_range> .

:partOfSeason
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "part of season" ;
    rdfs:comment "Associates a race with the championship season in which it occurs." ;
    rdfs:domain <https://example.org/f1-ontology/Race_partOfSeason_domain> ;
    rdfs:range <https://example.org/f1-ontology/Race_partOfSeason_range> .

:precedesRace
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "precedes race" ;
    rdfs:comment "Relates a race to the immediately following race within the same championship season, making race chronology explicit." ;
    rdfs:domain <https://example.org/f1-ontology/Race_precedesRace_domain> ;
    rdfs:range <https://example.org/f1-ontology/Race_precedesRace_range> .

:precedesSeason
    a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "precedes season" ;
    rdfs:comment "Relates a championship season to the immediately following championship season, making chronological order explicit." ;
    rdfs:domain <https://example.org/f1-ontology/Season_precedesSeason_domain> ;
    rdfs:range <https://example.org/f1-ontology/Season_precedesSeason_range> .

# ── Domain / Range class expressions (OWL equivalent axioms) ──────────────

<https://example.org/f1-ontology/SessionResult_hasBestLapTime_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :SessionResult [ a owl:Restriction ; owl:onProperty :hasBestLapTime ; owl:someValuesFrom xsd:decimal ] ) ] .

<https://example.org/f1-ontology/Circuit_hasCircuitName_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Circuit [ a owl:Restriction ; owl:onProperty :hasCircuitName ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/Circuit_hasCountry_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Circuit [ a owl:Restriction ; owl:onProperty :hasCountry ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/Driver_hasDateOfBirth_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Driver [ a owl:Restriction ; owl:onProperty :hasDateOfBirth ; owl:someValuesFrom xsd:date ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasDriver_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasDriver ; owl:someValuesFrom :Driver ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasDriver_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Driver [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasDriver ] ; owl:someValuesFrom :RaceEntry ] ) ] .

<https://example.org/f1-ontology/Driver_hasDriverName_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Driver [ a owl:Restriction ; owl:onProperty :hasDriverName ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasFinishPosition_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasFinishPosition ; owl:someValuesFrom :Position ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasFinishPosition_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Position [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasFinishPosition ] ; owl:someValuesFrom :RaceEntry ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasLapsCompleted_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasLapsCompleted ; owl:someValuesFrom xsd:integer ] ) ] .

<https://example.org/f1-ontology/Circuit_hasLocation_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Circuit [ a owl:Restriction ; owl:onProperty :hasLocation ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/Driver_hasNationality_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Driver [ a owl:Restriction ; owl:onProperty :hasNationality ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/SessionResult_hasPosition_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :SessionResult [ a owl:Restriction ; owl:onProperty :hasPosition ; owl:someValuesFrom :Position ] ) ] .

<https://example.org/f1-ontology/SessionResult_hasPosition_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Position [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasPosition ] ; owl:someValuesFrom :SessionResult ] ) ] .

<https://example.org/f1-ontology/Race_hasRaceDate_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty :hasRaceDate ; owl:someValuesFrom xsd:date ] ) ] .

<https://example.org/f1-ontology/Race_hasRaceEntry_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty :hasRaceEntry ; owl:someValuesFrom :RaceEntry ] ) ] .

<https://example.org/f1-ontology/Race_hasRaceEntry_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasRaceEntry ] ; owl:someValuesFrom :Race ] ) ] .

<https://example.org/f1-ontology/Race_hasRaceName_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty :hasRaceName ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasRacePoints_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasRacePoints ; owl:someValuesFrom xsd:boolean ] ) ] .

<https://example.org/f1-ontology/Position_hasRank_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Position [ a owl:Restriction ; owl:onProperty sulo:isReferredToIn ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( sulo:InformationObject [ a owl:Restriction ; owl:onProperty sulo:hasValue ; owl:someValuesFrom xsd:nonNegativeInteger ] ) ] ] ) ] .

<https://example.org/f1-ontology/Race_hasRound_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty :hasRound ; owl:someValuesFrom xsd:integer ] ) ] .

<https://example.org/f1-ontology/SessionResult_hasSessionLapsCompleted_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :SessionResult [ a owl:Restriction ; owl:onProperty :hasSessionLapsCompleted ; owl:someValuesFrom xsd:integer ] ) ] .

<https://example.org/f1-ontology/SessionResult_hasSessionPoints_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :SessionResult [ a owl:Restriction ; owl:onProperty :hasSessionPoints ; owl:someValuesFrom xsd:boolean ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasSessionResult_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasSessionResult ; owl:someValuesFrom :SessionResult ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasSessionResult_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :SessionResult [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasSessionResult ] ; owl:someValuesFrom :RaceEntry ] ) ] .

<https://example.org/f1-ontology/SessionResult_hasSessionType_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :SessionResult [ a owl:Restriction ; owl:onProperty :hasSessionType ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasStartPosition_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasStartPosition ; owl:someValuesFrom :Position ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasStartPosition_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Position [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasStartPosition ] ; owl:someValuesFrom :RaceEntry ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasStatus_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasStatus ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasTeam_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :RaceEntry [ a owl:Restriction ; owl:onProperty :hasTeam ; owl:someValuesFrom :Team ] ) ] .

<https://example.org/f1-ontology/RaceEntry_hasTeam_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Team [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :hasTeam ] ; owl:someValuesFrom :RaceEntry ] ) ] .

<https://example.org/f1-ontology/Team_hasTeamMember_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Team [ a owl:Restriction ; owl:onProperty sulo:hasItem ; owl:someValuesFrom :Driver ] ) ] .

<https://example.org/f1-ontology/Team_hasTeamMember_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Driver [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:hasItem ] ; owl:someValuesFrom :Team ] ) ] .

<https://example.org/f1-ontology/Team_hasTeamName_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Team [ a owl:Restriction ; owl:onProperty :hasTeamName ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/Team_hasTeamNationality_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Team [ a owl:Restriction ; owl:onProperty :hasTeamNationality ; owl:someValuesFrom xsd:string ] ) ] .

<https://example.org/f1-ontology/Season_hasYear_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Season [ a owl:Restriction ; owl:onProperty :hasYear ; owl:someValuesFrom xsd:integer ] ) ] .

<https://example.org/f1-ontology/Race_isInCircuit_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty sulo:isIn ; owl:someValuesFrom :Circuit ] ) ] .

<https://example.org/f1-ontology/Race_isInCircuit_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Circuit [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:isIn ] ; owl:someValuesFrom :Race ] ) ] .

<https://example.org/f1-ontology/Race_partOfSeason_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty :partOfSeason ; owl:someValuesFrom :Season ] ) ] .

<https://example.org/f1-ontology/Race_partOfSeason_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Season [ a owl:Restriction ; owl:onProperty [ owl:inverseOf :partOfSeason ] ; owl:someValuesFrom :Race ] ) ] .

<https://example.org/f1-ontology/Race_precedesRace_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty sulo:precedes ; owl:someValuesFrom :Race ] ) ] .

<https://example.org/f1-ontology/Race_precedesRace_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Race [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:precedes ] ; owl:someValuesFrom :Race ] ) ] .

<https://example.org/f1-ontology/Season_precedesSeason_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Season [ a owl:Restriction ; owl:onProperty sulo:precedes ; owl:someValuesFrom :Season ] ) ] .

<https://example.org/f1-ontology/Season_precedesSeason_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Season [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:precedes ] ; owl:someValuesFrom :Season ] ) ] .
